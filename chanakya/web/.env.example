# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.
# The anon key is safe to expose: Row Level Security is the access boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Absolute origin used to build auth redirect and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEVER put SUPABASE_SERVICE_ROLE_KEY in the web app. It belongs to background workers only.
